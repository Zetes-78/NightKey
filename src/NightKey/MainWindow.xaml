<Window x:Class="NightKey.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightKey" Width="460" Height="660" MinWidth="380" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NightBrush}" Foreground="{StaticResource StarlightBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="pack://application:,,,/Assets/nightkey.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid x:Name="MainContent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Margin="22,20,18,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Fill="{StaticResource TealBrush}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path.Data>
              <CombinedGeometry GeometryCombineMode="Exclude">
                <CombinedGeometry.Geometry1>
                  <EllipseGeometry Center="15,15" RadiusX="13" RadiusY="13"/>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2>
                  <EllipseGeometry Center="21,10" RadiusX="11" RadiusY="11"/>
                </CombinedGeometry.Geometry2>
              </CombinedGeometry>
            </Path.Data>
          </Path>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="NightKey" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="24"/>
            <TextBlock FontSize="12">
              <Hyperlink Foreground="{StaticResource HazeBrush}" TextDecorations="None" Cursor="Hand" Click="Website_Click"
                         ToolTip="Visit nighttech.solutions">by Night Tech Solutions</Hyperlink>
            </TextBlock>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Add account" Style="{StaticResource PrimaryButton}" Click="AddButton_Click"
                  ToolTip="Add account (Ctrl+N)"/>
          <Button x:Name="MenuButton" Content="⋯" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,8"
                  Click="MenuButton_Click" ToolTip="More options">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Back up accounts…" Click="Backup_Click"/>
                <MenuItem Header="Restore from backup…" Click="Restore_Click"/>
                <Separator/>
                <MenuItem x:Name="HelloMenuItem" Header="Require Windows Hello" IsCheckable="True" Click="HelloMenu_Click"/>
                <MenuItem Header="Lock now" InputGestureText="Ctrl+L" Click="LockMenu_Click"/>
                <Separator/>
                <MenuItem Header="Help and questions" Click="Help_Click"/>
                <MenuItem x:Name="UpdatesMenuItem" Header="Check for updates" Click="Updates_Click"/>
                <MenuItem Header="More free apps from Night Tech" Click="FreeApps_Click"/>
                <MenuItem Header="Visit nighttech.solutions" Click="Website_Click"/>
                <Separator/>
                <MenuItem Header="About NightKey" Click="About_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>

      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="22,0,22,10" Tag="Search accounts"
               TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

      <!-- Accounts -->
      <ScrollViewer x:Name="AccountsScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,0,10,12"
                    Focusable="False">
        <ItemsControl x:Name="AccountsList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource RowButton}" Margin="12,4" Click="Row_Click"
                      AutomationProperties.Name="{Binding Title}"
                      ToolTip="Select to copy the code">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy code" Click="CopyMenu_Click"/>
                    <MenuItem Header="Rename…" Click="RenameMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Remove…" Click="RemoveMenu_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- Moon-phase countdown: full when the code is fresh, new moon when it's about to change -->
                  <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="26" Height="26" Fill="{StaticResource HorizonBrush}"/>
                    <Path x:Name="MoonPath" Data="{Binding Moon}" Fill="{StaticResource StarlightBrush}"/>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Foreground="{StaticResource HazeBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock x:Name="CodeText" Grid.Column="2" Text="{Binding DisplayCode}" VerticalAlignment="Center"
                             FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="26"
                             Foreground="{StaticResource TealBrush}"/>
                </Grid>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpiring}" Value="True">
                  <Setter TargetName="CodeText" Property="Foreground" Value="{StaticResource EmberBrush}"/>
                  <Setter TargetName="MoonPath" Property="Fill" Value="{StaticResource EmberBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle}" Value="">
                  <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- First run -->
      <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                  MaxWidth="300" Visibility="Collapsed">
        <Grid Width="72" Height="72" HorizontalAlignment="Center">
          <Ellipse Stroke="{StaticResource HorizonBrush}" StrokeThickness="2"/>
          <Path Fill="{StaticResource TealBrush}">
            <Path.Data>
              <CombinedGeometry GeometryCombineMode="Exclude">
                <CombinedGeometry.Geometry1>
                  <EllipseGeometry Center="36,36" RadiusX="30" RadiusY="30"/>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2>
                  <EllipseGeometry Center="50,24" RadiusX="26" RadiusY="26"/>
                </CombinedGeometry.Geometry2>
              </CombinedGeometry>
            </Path.Data>
          </Path>
        </Grid>
        <TextBlock Text="No accounts yet" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                   HorizontalAlignment="Center" Margin="0,16,0,6"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource HazeBrush}"
                   Text="When a site shows a QR code to set up two-step sign-in, choose Add account, then Scan screen."/>
        <Button Content="Add your first account" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                HorizontalAlignment="Center" Click="AddButton_Click"/>
      </StackPanel>

      <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource DuskBrush}"
              BorderBrush="{StaticResource HorizonBrush}" BorderThickness="0,1,0,0" Padding="22,10"
              Visibility="Collapsed">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13"/>
      </Border>

      <!-- Night Tech footer -->
      <Border Grid.Row="4" BorderBrush="{StaticResource HorizonBrush}" BorderThickness="0,1,0,0" Padding="18,8">
        <DockPanel>
          <Border DockPanel.Dock="Left" Background="White" CornerRadius="5" Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/nighttech-logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Night Tech Solutions logo"/>
          </Border>
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12">
            <Hyperlink Foreground="{StaticResource TealBrush}" TextDecorations="None" Cursor="Hand" Click="Website_Click">nighttech.solutions</Hyperlink>
          </TextBlock>
          <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource HazeBrush}" TextTrimming="CharacterEllipsis">
            <Run Text="Computer trouble? "/><Hyperlink Foreground="{StaticResource HazeBrush}" Cursor="Hand" Click="Phone_Click" ToolTip="Call or text Night Tech Solutions"><Run x:Name="FooterPhone" Text="(864) 381-8510"/></Hyperlink>
          </TextBlock>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Locked -->
    <Grid x:Name="LockOverlay" Background="{StaticResource NightBrush}" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
        <Grid Width="96" Height="96" HorizontalAlignment="Center">
          <Ellipse Fill="{StaticResource DuskBrush}"/>
          <Path Fill="{StaticResource TealBrush}">
            <Path.Data>
              <CombinedGeometry GeometryCombineMode="Exclude">
                <CombinedGeometry.Geometry1>
                  <EllipseGeometry Center="48,48" RadiusX="34" RadiusY="34"/>
                </CombinedGeometry.Geometry1>
                <CombinedGeometry.Geometry2>
                  <EllipseGeometry Center="64,36" RadiusX="28" RadiusY="28"/>
                </CombinedGeometry.Geometry2>
              </CombinedGeometry>
            </Path.Data>
          </Path>
        </Grid>
        <TextBlock Text="NightKey is locked" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                   HorizontalAlignment="Center" Margin="0,20,0,6"/>
        <TextBlock x:Name="LockMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource HazeBrush}"
                   Text="Your codes stay hidden until Windows confirms it's you."/>
        <Button x:Name="UnlockButton" Content="Unlock with Windows Hello" Style="{StaticResource PrimaryButton}"
                Margin="0,20,0,0" HorizontalAlignment="Center" Click="Unlock_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
