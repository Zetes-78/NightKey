<Window x:Class="NightKey.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename account" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource NightBrush}" Foreground="{StaticResource StarlightBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
  <StackPanel Margin="24,20,24,22">
    <TextBlock Text="Rename account" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20"/>
    <TextBlock Text="Service" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="IssuerBox"/>
    <TextBlock Text="Account" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="NameBox"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"
               Foreground="{StaticResource EmberBrush}" Visibility="Collapsed"
               Text="Give the account a name so you can tell it apart."/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
