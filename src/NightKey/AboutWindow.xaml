<Window x:Class="NightKey.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About NightKey" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource NightBrush}" Foreground="{StaticResource StarlightBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="pack://application:,,,/Assets/nightkey.ico">
  <Window.Resources>
    <Style x:Key="LinkText" TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{StaticResource TealBrush}"/>
      <Setter Property="TextDecorations" Value="None"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="TextDecorations" Value="Underline"/>
          <Setter Property="Foreground" Value="{StaticResource TealHoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <StackPanel Margin="26,24,26,22">
    <StackPanel Orientation="Horizontal">
      <Border Background="White" CornerRadius="10" Padding="5" Margin="0,0,14,0">
        <Image Source="pack://application:,,,/Assets/nighttech-logo.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality"
               AutomationProperties.Name="Night Tech Solutions logo"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="NightKey" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="26"/>
        <TextBlock x:Name="VersionText" Foreground="{StaticResource HazeBrush}" FontSize="13"/>
      </StackPanel>
    </StackPanel>

    <TextBlock TextWrapping="Wrap" Margin="0,18,0,0" Foreground="{StaticResource HazeBrush}"
               Text="Free two-step sign-in codes for Windows. Your secret keys are encrypted on this PC and never leave it. No accounts, ads or tracking."/>

    <Border Background="{StaticResource DuskBrush}" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="Made by Night Tech Solutions" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource HazeBrush}" FontSize="13" Margin="0,4,0,10"
                   Text="A family-owned computer repair and IT support business in the Upstate of South Carolina, open evenings and weekends."/>
        <TextBlock Margin="0,2"><Hyperlink Style="{StaticResource LinkText}" Click="Website_Click">nighttech.solutions</Hyperlink></TextBlock>
        <TextBlock Margin="0,2"><Run Text="Call or text "/><Hyperlink Style="{StaticResource LinkText}" Click="Phone_Click"><Run x:Name="PhoneRun"/></Hyperlink></TextBlock>
        <TextBlock Margin="0,2"><Hyperlink Style="{StaticResource LinkText}" Click="Help_Click">NightKey help and questions</Hyperlink></TextBlock>
        <TextBlock Margin="0,2"><Hyperlink Style="{StaticResource LinkText}" Click="FreeApps_Click">More free apps from Night Tech</Hyperlink></TextBlock>
      </StackPanel>
    </Border>

    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource HazeBrush}" Margin="0,16,0,0">
      <Hyperlink Style="{StaticResource LinkText}" Click="Privacy_Click">Privacy</Hyperlink>
      <Run Text="  ·  "/>
      <Hyperlink Style="{StaticResource LinkText}" Click="Source_Click">Source code (MIT License)</Hyperlink>
      <LineBreak/>
      <Run Text="QR scanning uses ZXing.Net (Apache License 2.0)."/>
      <LineBreak/>
      <Run Text="© 2026 Night Tech Solutions"/>
    </TextBlock>

    <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0"
            IsDefault="True" IsCancel="True" Click="Close_Click"/>
  </StackPanel>
</Window>
