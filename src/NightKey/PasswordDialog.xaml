<Window x:Class="NightKey.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource NightBrush}" Foreground="{StaticResource StarlightBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
  <StackPanel Margin="24,20,24,22">
    <TextBlock x:Name="HeadingText" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="20"/>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource HazeBrush}" Margin="0,6,0,0"/>

    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
    <PasswordBox x:Name="PasswordBox1"/>

    <StackPanel x:Name="ConfirmPanel">
      <TextBlock Text="Type it again" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="PasswordBox2"/>
    </StackPanel>

    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0"
               Foreground="{StaticResource EmberBrush}" Visibility="Collapsed"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
